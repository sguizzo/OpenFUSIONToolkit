&runtime_options
  ppn=1
  omp_nthreads=4
  debug=0
/

&mesh_options
  grid_order=2   ! required: the library aborts if this namelist is absent
/

&native_mesh_options
  filename="cyl_pump_mesh_native.h5"
/

&em_pump_options
  order=2
  n_seg=6
  n_per_lam=3
  nsteps=20
  rst_freq=1
  dt=2.0E-3
  freq=50.0
  I0=4.0E4
  ramp_time=1.0E-2
  rho_fluid=1.94E3
  eta_fluid=1.625E-3
  eta_wall=1.2E-6
  eta_vac=1.0E7
  nu_fluid=3.0E-5
  lin_tol=1.0E-7
  nl_tol=1.0E-6
  v_inlet=1.0
  first_wall_region=5
  second_wall_region=6
  iron_region=4
  coil_reg0=7
  mf_b0=1.0E-7
  cyl=T
  flow_on=F
/

&xmhd_plot_options
  rst_start=0
  rst_end=2000
/