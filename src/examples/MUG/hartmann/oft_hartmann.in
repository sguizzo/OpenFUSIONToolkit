&runtime_options
 ppn=1
 debug=0
/

&mesh_options
 meshname='hartmann'
 cad_type=0
 nlevels=1
 nbase=1
 grid_order=1
 fix_boundary=T
/

! Graded duct mesh, generated by make_mesh.py. The grading is tuned to Ha below:
!   python3 make_mesh.py --a 0.025 --b 0.025 --Ha 80 --na 40 --nb 20 -o hartmann_mesh.h5
! It puts 4 cells (8 order-2 nodes) in both the Hartmann and side layers, using
! 6400 triangles where a uniform mesh at the same wall spacing would need ~8x more.
! Regenerate if a_chan, b_chan or Ha change -- the layer widths scale with them.
&native_mesh_options
 filename="hartmann_mesh.h5"
 ref_periodic=F
/

&hartmann_options
 order=2
 a_chan=2.5E-2
 b_chan=2.5E-2
 Ha=80.0
 rho_fluid=2000.0
 mu_fluid=10.0E-3
 sigma=4.0d2
 force_y=3.7335E4
 m_i=205.0
 dt=5.0E-2
 nsteps=40
 rst_freq=10
 insulating=F
 use_mfnk=T
 pm=T
/

&xmhd_plot_options
 rst_start=0
 rst_end=2000
/
